{
  "name": "drive",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.8",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0"
  },
  "scripts": {
    "db:push": "bun run drizzle-kit push",
    "db:push:test": "DB_FILE_NAME=file:local.test.db bun run drizzle-kit push",
    "cli": "bun run src/cli/index.ts",
    "test": "bun run db:push:test && DB_FILE_NAME=file:local.test.db bun test",
    "test:coverage": "bun run db:push:test && DB_FILE_NAME=file:local.test.db bun test --coverage"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "clipanion": "^4.0.0-rc.4",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.0",
    "motion": "^12.23.25",
    "pino": "^10.1.0",
    "react": "^19.2.1",
    "react-native": "^0.82.1",
    "ts-pattern": "^5.9.0",
    "uuid": "^13.0.0"
  }
}
